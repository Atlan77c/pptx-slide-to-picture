<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.Atlan77c</groupId>
  <artifactId>pptx-slide-to-image</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>pptx-slide-to-image</name>
  <description>
    Librairie Java pour convertir une slide d'un fichier PowerPoint (.pptx) en image (PNG, JPEG ou SVG),
    en pur Java via Apache POI et Apache Batik - sans dependance a LibreOffice, PowerPoint ou un navigateur headless.
  </description>
  <url>https://github.com/Atlan77c/pptx-slide-to-image</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <poi.version>5.2.5</poi.version>
    <slf4j.version>2.0.13</slf4j.version>
    <junit.version>5.10.2</junit.version>
    <batik.version>1.18</batik.version>
  </properties>

  <dependencies>
    <!-- Apache POI : lecture/rendu natif des fichiers .pptx (OOXML) -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-scratchpad</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!--
      Export SVG (rendu vectoriel) : org.apache.batik:batik-svggen fournit
      SVGGraphics2D, une implementation de java.awt.Graphics2D qui capture les
      appels de dessin et les serialise en SVG au lieu de peindre des pixels -
      reutilise donc tel quel le meme pipeline de rendu (XSLFSlide.draw(),
      correctif de debordement de texte) que pour le PNG/JPEG.
      Choisi plutot que JFreeSVG (GPLv3/commercial, incompatible avec la
      licence MIT de ce projet) : Batik est sous licence Apache 2.0, permissive
      comme POI et comme ce projet.
    -->
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-svggen</artifactId>
      <version>${batik.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-dom</artifactId>
      <version>${batik.version}</version>
    </dependency>

    <!--
      Journalisation : uniquement l'API SLF4J (pas d'implementation concrete liee).
      C'est une bonne pratique pour une librairie destinee a etre reutilisee : on ne force
      jamais de backend de logs (Logback, Log4j2...) sur les projets qui vont la consommer.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
